<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Vibe Launcher"
           Manufacturer="Vibe Launcher"
           Version="$(var.Version)"
           UpgradeCode="B575F3D8-DF46-4DBC-AC34-16BEDA3321B5"
           Scope="perUser"
           Language="1049"
           Codepage="65001"
           Compressed="yes">

    <SummaryInformation Description="Vibe Launcher — лаунчер Minecraft для Windows"
                        Manufacturer="Vibe Launcher" />

    <MajorUpgrade DowngradeErrorMessage="На компьютере уже установлена более новая версия Vibe Launcher." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.ProjectDir)\Assets\VibeLauncher.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/S1awwk0/VibeLauncher" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <Property Id="STARTMENU_SHORTCUT" Value="1" Secure="yes" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" Secure="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)\installer\License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.ProjectDir)\installer\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.ProjectDir)\installer\dialog.bmp" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="VibeLauncher" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuDir" Name="Vibe Launcher" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Vibe Launcher" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="Установка [ProductName]" NoMinimize="yes">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Ярлыки" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Выберите, какие ярлыки создать." />
        <Control Id="StartMenuCheckBox" Type="CheckBox" X="20" Y="60" Width="330" Height="17" Property="STARTMENU_SHORTCUT" CheckBoxValue="1" Text="Создать папку и ярлык в меню «Пуск»" />
        <Control Id="DesktopCheckBox" Type="CheckBox" X="20" Y="85" Width="330" Height="17" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Создать ярлык на рабочем столе" />
        <Control Id="Hint" Type="Text" X="20" Y="115" Width="330" Height="30" Transparent="yes" NoPrefix="yes" Text="Ярлыки всегда можно создать или удалить вручную." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="2" />
    </UI>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppProgramMenuDir" Guid="B8019487-9EB3-4A12-B654-811BBA421979" Condition="STARTMENU_SHORTCUT=1">
      <Shortcut Id="StartMenuShortcut"
                Name="Vibe Launcher"
                Description="Запустить Vibe Launcher"
                Target="[INSTALLFOLDER]VibeLauncher.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveAppProgramMenuDir" Directory="AppProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Vibe Launcher" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="55ABA7A0-6076-4354-B928-439FBD888CCB" Condition="DESKTOP_SHORTCUT=1">
      <Shortcut Id="DesktopShortcut"
                Name="Vibe Launcher"
                Description="Запустить Vibe Launcher"
                Target="[INSTALLFOLDER]VibeLauncher.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\Vibe Launcher" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
