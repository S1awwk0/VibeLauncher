<Window x:Class="VibeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VibeLauncher.Models"
        Title="Vibe Launcher" Icon="Assets/VibeLauncher.ico" Width="1240" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" Loaded="Window_Loaded">

    <Window.Resources>
        <DataTemplate x:Key="AvailableVersionTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,2,0,0">
                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding ReleaseTime, Mode=OneWay, StringFormat=dd.MM.yyyy}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="Установить" Style="{StaticResource SmallButton}"
                        Tag="{Binding Id}" Click="InstallVersion_Click" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InstalledVersionTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12.5"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Играть" Style="{StaticResource SmallButton}" Tag="{Binding Id}"
                            Click="LaunchInstalledVersion_Click"/>
                    <Button Content="Удалить" Style="{StaticResource DangerButton}" FontSize="10.5"
                            Padding="9,4" Margin="6,0,0,0" Tag="{Binding Id}" Click="DeleteVersion_Click"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InstanceTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ModHitTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="#0E111A" ClipToBounds="True">
                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="10" Foreground="#636C80" Margin="0,2,0,0">
                        <Run Text="{Binding Author, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding DownloadsText, Mode=OneWay}"/>
                        <Run Text=" загрузок"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="Установить" Style="{StaticResource SmallButton}"
                        Tag="{Binding ProjectId}" Click="InstallMod_Click" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ModFileTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Удалить" Style="{StaticResource DangerButton}" FontSize="10"
                        Padding="8,3" Tag="{Binding}" Click="RemoveMod_Click" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LogTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FindingTemplate">
            <Border Background="#121622" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding SeverityColor}" CornerRadius="5" Padding="7,2" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SeverityLabel}" FontSize="10" FontWeight="Bold" Foreground="#0B0D12"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Cause}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding Fix}" Foreground="#C4B5FD" FontSize="12" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Evidence}" FontFamily="Consolas" FontSize="10.5" Foreground="#6B7280"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR ═══════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,22,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="8,0,8,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VIBE" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="minecraft launcher" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="NavHome" Style="{StaticResource NavButton}" Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Играть" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavVersions" Style="{StaticResource NavButton}" Click="NavVersions_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Версии" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavInstances" Style="{StaticResource NavButton}" Click="NavInstances_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Сборки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSkins" Style="{StaticResource NavButton}" Click="NavSkins_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Скины" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Click="NavLogs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Логи" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource CardTight}" Background="#141826" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#2A2145">
                                <TextBlock x:Name="SideInitial" Text="?" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource Accent2Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="128">
                                <TextBlock x:Name="SideAccountName" Text="Не выполнен вход" FontSize="12.5"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SideAccountType" Text="гость" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v1.0.0 · Vibe" FontSize="10" Foreground="#555E72" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ PAGE: HOME ═══════════════ -->
        <Grid x:Name="PageHome" Grid.Column="1" Margin="34,26,34,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Библиотека" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Запускайте игру, управляйте версиями и сборками"
                               Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="16" Background="#262040">
                                    <TextBlock x:Name="AccountInitial" Text="?" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource Accent2Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" Text="Не выполнен вход" FontSize="17" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AccountType" Text="Войдите, чтобы играть онлайн" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="MsLoginButton" Content="Microsoft"
                                        Style="{StaticResource PrimaryButton}" Padding="13,7" FontSize="12"
                                        VerticalAlignment="Center" Click="MsLogin_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Офлайн-режим" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                <TextBlock Text="Для пиратки и одиночной игры" Style="{StaticResource Hint}" Margin="0,3,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="OfflineLoginButton" Content="Офлайн-аккаунт"
                                            Style="{StaticResource SmallButton}" Click="OfflineLogin_Click"/>
                                    <Button x:Name="LogoutButton" Content="Выйти" Style="{StaticResource GhostButton}"
                                            FontSize="11.5" Padding="11,5" Margin="8,0,0,0" Click="Logout_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Play card -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Запустить игру" Style="{StaticResource SectionTitle}"/>
                                    <ComboBox x:Name="HomeTargetCombo" Height="40" Margin="0,10,16,0" MinWidth="440" MaxWidth="560"
                                              HorizontalAlignment="Left" SelectionChanged="HomeTargetCombo_SelectionChanged"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="PlayButton" Width="190" Height="58" Click="Play_Click"
                                        Background="{StaticResource AccentGradient}" Foreground="White"
                                        FontSize="18" FontWeight="Bold" Content="ИГРАТЬ" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Margin="0,16,0,0">
                                <ProgressBar x:Name="InstallProgress" Height="6" Value="0" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="StatusText" Text="Готово к запуску" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="StatusDetail" Text="" FontSize="11.5" Margin="10,0,0,0"
                                               Foreground="#5E677D" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stats -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardTight}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="StatsVersions" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource Accent2Brush}"/>
                                <TextBlock Text="установлено версий" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardTight}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="StatsInstances" Text="0" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="сборок" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardTight}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="StatsRam" Text="4 ГБ" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="выделено памяти" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource CardTight}">
                            <StackPanel>
                                <TextBlock x:Name="StatsJava" Text="—" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="Java" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Analysis -->
                    <Border x:Name="HomeAnalysisPanel" Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock x:Name="HomeAnalysisTitle" Text="Анализ последнего запуска"
                                           Style="{StaticResource SectionTitle}" FontSize="14"/>
                                <Button Content="Все логи →" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" Click="GoLogs_Click"/>
                            </Grid>
                            <ItemsControl x:Name="HomeFindingsList" ItemTemplate="{StaticResource FindingTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════ PAGE: VERSIONS ═══════════════ -->
        <Grid x:Name="PageVersions" Grid.Column="1" Margin="34,26,34,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Версии" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Ванильные версии и загрузчики модов: Fabric, Quilt, Forge, NeoForge"
                           Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="398"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,16,18,8">
                            <TextBlock Text="Список версий" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox x:Name="SnapshotsCheck" Content="Снапшоты" FontSize="11.5" Margin="0,0,10,0"
                                          Checked="Snapshots_Changed" Unchecked="Snapshots_Changed"/>
                                <Button Content="Обновить" Style="{StaticResource SmallButton}" Click="RefreshVersions_Click"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="18,0,18,4">
                            <TextBlock Text="Установленные" Style="{StaticResource FieldLabel}"/>
                            <ListBox x:Name="InstalledVersionsList" MaxHeight="200" ItemTemplate="{StaticResource InstalledVersionTemplate}"/>
                            <TextBlock x:Name="NoInstalledText" Text="Пока ничего не установлено" Style="{StaticResource Hint}"
                                       Margin="4,2,0,4" Visibility="Collapsed"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="18,10,18,6">
                            <TextBlock Text="Доступные" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="VersionFilterBox" Width="230" Height="30" HorizontalAlignment="Right"
                                     TextChanged="VersionFilter_TextChanged" ToolTip="Фильтр по версии"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="12,0,12,8">
                            <ListBox x:Name="AvailableVersionsList" ItemTemplate="{StaticResource AvailableVersionTemplate}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                            <TextBlock x:Name="AvailableStatus" Text="Загрузка списка версий…" Style="{StaticResource Hint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>
                        </Grid>

                        <StackPanel Grid.Row="4" Margin="18,0,18,16">
                            <ProgressBar x:Name="VersionsProgress" Height="5" Visibility="Collapsed" Value="0"/>
                            <TextBlock x:Name="VersionsStatus" Text="" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Загрузчик модов" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Ядро установится в папку лаунчера и появится в списке версий"
                                           Style="{StaticResource Hint}" Margin="0,4,0,14"/>

                                <TextBlock Text="Загрузчик" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LoaderTypeCombo" Height="36" SelectionChanged="LoaderType_SelectionChanged"/>

                                <TextBlock Text="Версия Minecraft" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                <ComboBox x:Name="LoaderMcCombo" Height="36" MaxDropDownHeight="360"
                                          SelectionChanged="LoaderMc_SelectionChanged" ToolTip="Выберите версию Minecraft"/>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Версия загрузчика" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button Content="обновить" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                            Click="RefreshLoaderVersions_Click"/>
                                </Grid>
                                <ComboBox x:Name="LoaderVersionCombo" Height="36"/>

                                <Button x:Name="InstallLoaderButton" Content="Установить загрузчик"
                                        Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="InstallLoader_Click"/>
                                <TextBlock x:Name="LoaderStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Fabric · выберите версию игры"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Java" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="JavaRecommendText" Style="{StaticResource Hint}" Margin="0,4,0,12"
                                           Text="Рекомендуемая версия определится по игре"/>
                                <TextBlock Text="Обнаруженные установки" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="JavaCombo" Height="36" SelectionChanged="JavaCombo_SelectionChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Найти Java" Style="{StaticResource SmallButton}" Click="DetectJava_Click"/>
                                    <Button Content="Скачать Java 21" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                            Tag="21" Click="DownloadJava_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="JavaStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Подсказка" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Forge и NeoForge устанавливаются официальным установщиком и могут скачивать библиотеки несколько минут. Fabric/Quilt ставятся почти мгновенно. Для сборок с модами используйте вкладку «Сборки»."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══════════════ PAGE: INSTANCES ═══════════════ -->
        <Grid x:Name="PageInstances" Grid.Column="1" Margin="34,26,34,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Сборки" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Отдельные профили с модами, мирами и настройками"
                               Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Импорт .mrpack" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Click="ImportMrpack_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="318"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Мои сборки" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" x:Name="InstancesList" ItemTemplate="{StaticResource InstanceTemplate}"
                                 SelectionChanged="InstancesList_SelectionChanged"/>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Border Background="#10141E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Новая сборка" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Название" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NewInstanceName" Height="32" ToolTip="Название сборки" Margin="0,0,0,6"/>
                                    <TextBlock Text="Версия Minecraft" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="NewInstanceMcCombo" Height="32" MaxDropDownHeight="320"
                                              ToolTip="Выберите версию Minecraft" Margin="0,0,0,6"/>
                                    <TextBlock Text="Ядро" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="NewInstanceLoader" Height="32" Margin="0,0,0,6"
                                              SelectionChanged="NewInstanceLoader_SelectionChanged"/>
                                    <TextBlock Text="Версия ядра (авто)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NewInstanceLoaderVersion" Height="32" ToolTip="Версия загрузчика (авто)" Margin="0,0,0,6"/>
                                    <Button Content="Создать сборку" Style="{StaticResource PrimaryButton}" FontSize="12"
                                            Padding="10,7" Click="CreateInstance_Click"/>
                                    <TextBlock x:Name="CreateStatus" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Border x:Name="NoInstancePanel" Style="{StaticResource Card}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="Выберите сборку" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="или создайте новую слева. В сборку можно скачивать моды напрямую с Modrinth."
                                       Style="{StaticResource Hint}" TextAlignment="Center" FontSize="12.5" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="InstancePanel" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock x:Name="InstanceTitle" Text="Сборка" FontSize="21" FontWeight="Bold"/>
                                    <TextBlock x:Name="InstanceSubtitle" Text="" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="InstancePlayButton" Content="Играть" Style="{StaticResource PrimaryButton}"
                                            Padding="18,8" Click="InstancePlay_Click"/>
                                    <Button Content="Папка" Style="{StaticResource GhostButton}" Margin="7,0,0,0"
                                            Padding="12,8" Click="InstanceOpenFolder_Click"/>
                                    <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="7,0,0,0"
                                            Padding="12,8" Click="InstanceDelete_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" x:Name="InstanceStatus" Style="{StaticResource Hint}" Margin="0,10,0,4"
                                       TextTrimming="CharacterEllipsis"/>

                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Моды с Modrinth" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                    <Grid Grid.Row="1" Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ModSearchBox" Height="34" KeyDown="ModSearchBox_KeyDown"
                                                 ToolTip="Название мода, например Sodium, JEI, Create"/>
                                        <Button Grid.Column="1" Content="Найти" Style="{StaticResource SmallButton}"
                                                Margin="7,0,0,0" Padding="14,5" Click="ModSearch_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <ListBox x:Name="ModResultsList" ItemTemplate="{StaticResource ModHitTemplate}"/>
                                        <TextBlock x:Name="ModSearchStatus" Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                                                   Text="Введите запрос и нажмите «Найти»"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="Установленные моды" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                        <TextBlock x:Name="ModsCount" Text="" Style="{StaticResource Hint}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ListBox Grid.Row="1" x:Name="ModsList" Margin="0,8,0,0"
                                             ItemTemplate="{StaticResource ModFileTemplate}"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Папка mods" Style="{StaticResource SmallButton}"
                                                Click="OpenModsFolder_Click"/>
                                        <Button x:Name="InstallCslButton" Content="CustomSkinLoader"
                                                Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                                Click="InstallCsl_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════ PAGE: SKINS ═══════════════ -->
        <Grid x:Name="PageSkins" Grid.Column="1" Margin="34,26,34,20" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Скины и плащи" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Mojang, Ely.by, TLauncher и локальные файлы"
                               Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Скин" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SkinProviderText" Text="" Style="{StaticResource Hint}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="210" Height="210" Background="#0E111A" CornerRadius="14"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image x:Name="SkinImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Margin="12"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Text="Голова" Style="{StaticResource FieldLabel}"/>
                                        <Border Width="82" Height="82" Background="#0E111A" CornerRadius="10"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                HorizontalAlignment="Left">
                                            <Image x:Name="HeadImage" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   Margin="5"/>
                                        </Border>
                                        <TextBlock Text="Плащ" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                                        <Border Width="100" Height="126" Background="#0E111A" CornerRadius="10"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                HorizontalAlignment="Left">
                                            <Image x:Name="CapeImage" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="6"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="SkinNameText" Text="Скин не выбран" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,16,0,0"/>
                                <TextBlock x:Name="SkinModelText" Text="" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Загрузить скин" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                    <TextBlock Text="Провайдер" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                    <ComboBox x:Name="SkinProviderCombo" Height="34" SelectionChanged="SkinProvider_SelectionChanged"/>
                                    <TextBlock Text="Никнейм" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                    <TextBox x:Name="SkinNicknameBox" Height="34" KeyDown="SkinNicknameBox_KeyDown"/>
                                    <Button x:Name="LoadSkinButton" Content="Загрузить"
                                            Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="LoadSkin_Click"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Импорт TLauncher" Style="{StaticResource SmallButton}"
                                                Click="TlauncherImport_Click"/>
                                        <Button Content="Файл скина" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                                Click="PickSkinFile_Click"/>
                                    </StackPanel>
                                    <Button Content="Файл плаща" Style="{StaticResource GhostButton}" FontSize="11.5"
                                            Padding="11,5" HorizontalAlignment="Left" Margin="0,7,0,0" Click="PickCapeFile_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Применить" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                    <TextBlock Text="Сборка" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                    <ComboBox x:Name="SkinInstanceCombo" Height="34"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Применить в сборку" Style="{StaticResource PrimaryButton}"
                                                FontSize="12" Padding="12,7" Click="ApplySkin_Click"/>
                                        <Button Content="Сохранить в аккаунт" Style="{StaticResource GhostButton}"
                                                FontSize="12" Padding="12,7" Margin="7,0,0,0" Click="SaveSkinAccount_Click"/>
                                    </StackPanel>
                                    <Button x:Name="SkinCslButton" Content="Установить CustomSkinLoader в сборку"
                                            Style="{StaticResource SmallButton}" Margin="0,8,0,0" Click="SkinCsl_Click"/>
                                    <TextBlock x:Name="SkinStatus" Style="{StaticResource Hint}" Margin="0,9,0,0"
                                               Text="Скины отображаются в игре через мод CustomSkinLoader."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Mojang и Ely.by загружаются по никнейму. TLauncher не имеет публичного API скинов — лаунчер ищет файлы в локальных папках TLauncher, также можно импортировать PNG вручную. Для отображения скина в офлайн-игре установите CustomSkinLoader и примените скин в сборку."/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════ PAGE: LOGS ═══════════════ -->
        <Grid x:Name="PageLogs" Grid.Column="1" Margin="34,26,34,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Логи и краши" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Автоматический разбор ошибок при запуске Minecraft"
                               Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Обновить" Style="{StaticResource SmallButton}" Click="RefreshLogs_Click"/>
                    <Button Content="Папка логов" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                            Click="OpenLogsFolder_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Файлы логов" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1" x:Name="LogsList" ItemTemplate="{StaticResource LogTemplate}"
                                 SelectionChanged="LogsList_SelectionChanged"/>
                        <Button Grid.Row="2" x:Name="DeleteLogButton" Content="Удалить выбранный лог"
                                Style="{StaticResource DangerButton}" FontSize="11.5" Padding="10,6"
                                Margin="0,8,0,0" Click="DeleteLog_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock x:Name="LogTitle" Text="Выберите лог" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogStatusText" Text="" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Content="Анализировать" Style="{StaticResource PrimaryButton}" FontSize="12"
                                Padding="13,7" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="AnalyzeLog_Click"/>
                    </Grid>

                    <Border Grid.Row="1" x:Name="LogAnalysisPanel" Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="Collapsed" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogFindingsList" ItemTemplate="{StaticResource FindingTemplate}"/>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                        <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                                 Background="#0A0D14" Foreground="#A9B3C9" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Padding="14" TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════ PAGE: SETTINGS ═══════════════ -->
        <Grid x:Name="PageSettings" Grid.Column="1" Margin="34,26,34,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Настройки" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Память, Java, параметры запуска и служебные папки"
                           Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Производительность" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="Оперативная память" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RamValueText" Text="4096 МБ" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent2Brush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="RamSlider" Minimum="1024" Maximum="32768" Value="4096"
                                            TickFrequency="512" IsSnapToTickEnabled="True" Margin="0,2,0,0"
                                            ValueChanged="RamSlider_ValueChanged"/>
                                    <TextBlock Text="Для сборок с модами рекомендуется 6144–10240 МБ. Не выделяйте больше, чем свободно в системе."
                                               Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                                    <TextBlock Text="Дополнительные аргументы JVM" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="JvmArgsBox" Height="36" ToolTip="-XX:+UseG1GC -Dfoo=bar"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Ширина окна" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="WidthBox" Height="34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Высота окна" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="HeightBox" Height="34"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="FullscreenCheck" Content="Полноэкранный режим" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Java" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Обнаруженные установки" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                    <ComboBox x:Name="SettingsJavaCombo" Height="36"
                                              SelectionChanged="SettingsJavaCombo_SelectionChanged"/>
                                    <TextBlock Text="Путь к java.exe" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="JavaPathBox" Height="34"/>
                                        <Button Grid.Column="1" Content="Обзор" Style="{StaticResource SmallButton}"
                                                Margin="7,0,0,0" Click="BrowseJava_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Content="Определить" Style="{StaticResource SmallButton}" Click="DetectJavaSettings_Click"/>
                                        <Button Content="Java 21" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                                Tag="21" Click="DownloadJavaSettings_Click"/>
                                        <Button Content="Java 17" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                                Tag="17" Click="DownloadJavaSettings_Click"/>
                                        <Button Content="Java 8" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                                Tag="8" Click="DownloadJavaSettings_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsJavaStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Папки" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Каталог игры для отдельных версий" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GameDirBox" Height="34"/>
                                        <Button Grid.Column="1" Content="Обзор" Style="{StaticResource SmallButton}"
                                                Margin="7,0,0,0" Click="BrowseGameDir_Click"/>
                                    </Grid>
                                    <TextBlock Text="Сборки всегда используют собственную папку — этот путь действует только для версий, запускаемых напрямую."
                                               Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    <Button Content="Открыть папку лаунчера" Style="{StaticResource GhostButton}"
                                            FontSize="12" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Click="OpenDataFolder_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Аккаунт Microsoft" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Application (client) ID из Azure" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                    <TextBox x:Name="MsClientIdBox" Height="34"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0"
                                               Text="Создайте приложение в Azure Portal → Microsoft Entra ID → App registrations, включите «Allow public client flows» и вставьте Client ID. Без него вход Microsoft недоступен, офлайн-режим работает всегда."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Поведение" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="ShowSnapshotsCheck" Content="Показывать снапшоты в списке версий" Margin="0,12,0,0"
                                              Checked="Snapshots_Changed" Unchecked="Snapshots_Changed"/>
                                    <TextBlock Text="Данные лаунчера" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                                    <TextBlock x:Name="DataPathText" Style="{StaticResource Hint}" FontFamily="Consolas" FontSize="10.5"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/>
                                <TextBlock x:Name="SettingsSavedText" Text="" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════ OVERLAY ═══════════════ -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Background="#D40A0C12" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="480" Padding="26" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Background="#151926">
                <StackPanel>
                    <TextBlock x:Name="OverlayTitle" Text="Вход" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="OverlayMessage" Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="12.5"/>
                    <TextBlock x:Name="OverlayCode" Text="" FontSize="30" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource Accent2Brush}" HorizontalAlignment="Center" Margin="0,18,0,10"/>
                    <Button x:Name="OverlayLinkButton" Content="Открыть страницу входа" Style="{StaticResource PrimaryButton}"
                            Margin="0,4,0,0" Click="OverlayLink_Click" Visibility="Collapsed"/>
                    <Button Content="Отмена" Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="OverlayCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
